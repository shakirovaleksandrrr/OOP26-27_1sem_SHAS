@echo off
cd /d "%~dp0"
chcp 65001 > nul
echo ==================================================================
echo   ЗАПУСК АВТОТЕСТОВ ПО ВСЕМ ЛАБОРАТОРНЫМ РАБОТАМ (3, 4, 5, 6, 7)
echo ==================================================================
echo.

setlocal enabledelayedexpansion
set "LABS=lab03 lab04 lab05 lab06 lab07"

for %%L in (%LABS%) do (
    echo ------------------------------------------------------------------
    echo [*] Прогоняем тесты для %%L...
    echo ------------------------------------------------------------------
    cd /d "%~dp0%%L"
    if exist run_tests.bat (
        call run_tests.bat < nul
    )
    echo.
)

cd /d "%~dp0"
echo ==================================================================
echo   ВСЕ ТЕСТЫ ЗАВЕРШЕНЫ.
echo ==================================================================
echo Нажмите любую клавишу для выхода...
pause > nul
