@echo off
cd /d "%~dp0"
chcp 65001 > nul
echo ==================================================================
echo   СБОРКА И ТЕСТИРОВАНИЕ ВСЕХ ЛАБОРАТОРНЫХ РАБОТ (3, 4, 5, 6, 7)
echo ==================================================================
echo.

setlocal enabledelayedexpansion
set "LABS=lab03 lab04 lab05 lab06 lab07"

for %%L in (%LABS%) do (
    echo ------------------------------------------------------------------
    echo [*] Сборка и тестирование %%L...
    echo ------------------------------------------------------------------
    cd /d "%~dp0%%L"
    powershell -ExecutionPolicy Bypass -File build.ps1
    if !errorlevel! neq 0 (
        echo [ОШИБКА] Сборка %%L завершилась с ошибкой!
        goto :failed
    )
    echo.
)

cd /d "%~dp0"
echo ==================================================================
echo   УСПЕХ: ВСЕ ЛАБОРАТОРНЫЕ РАБОТЫ (3-7) УСПЕШНО СОБРАНЫ И ПРОТЕСТИРОВАНЫ!
echo ==================================================================
goto :end

:failed
echo.
echo ==================================================================
echo [FAIL] Процесс прерван из-за ошибок в одной из лабораторных работ.
echo ==================================================================

:end
echo.
echo Нажмите любую клавишу для закрытия окна...
pause > nul
